# Copy to .env for local runs. .env is gitignored. Never commit real keys.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Local only, if you are not using `gcloud auth application-default login`:
# GEMINI_API_KEY=
# STORE=memory          # skip Firestore locally
# MOCK_GEMINI=1         # UI work without Gemini. Never on the judged deployment.
